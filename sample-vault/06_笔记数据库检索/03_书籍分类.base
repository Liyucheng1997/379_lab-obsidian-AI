views:
  - type: kanban
    name: 01_哲学政治
    filters:
      and:
        - 书籍 == "哲学政治"
    groupBy:
      property: states
      direction: ASC
    order:
      - file.name
      - date
    cardSize: 130
    image: note.cover
    imageAspectRatio: 0.7
    columnWidth: 200
