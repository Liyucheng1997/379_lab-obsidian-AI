views:
  - type: cards
    name: 01_全部人物
    filters:
      and:
        - 类型 == "人物"
    groupBy:
      property: 研究领域
      direction: ASC
    order:
      - file.name
      - 研究领域
    sort:
      - property: file.basename
        direction: ASC
    image: note.cover
    cardSize: 120
  - type: cards
    name: 02_政治军事
    filters:
      and:
        - 类型 == "人物"
        - 研究领域 == "政治军事"
    order:
      - file.name
    image: note.cover
    cardSize: 120
